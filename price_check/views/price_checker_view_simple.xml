<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Standalone minimal form (no image, no 'New Scan' button) -->
    <record id="view_price_checker_wizard_form_simple" model="ir.ui.view">
        <field name="name">price.checker.wizard.form.simple</field>
        <field name="model">price.checker.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Checker / فاحص الأسعار">
                <group col="3">
                    <group/>
                    <group>
                        <field name="barcode" placeholder="Scan / امسح الباركود" required="1"/>
                    </group>
                    <group/>
                </group>

                <separator string="Result / النتيجة"/>

                <group>
                    <group>
                        <field name="name_html" widget="html" nolabel="1"/>
                        <field name="barcode_html" widget="html" nolabel="1"/>
                        <field name="price_html" widget="html" nolabel="1"/>
                        <field name="uom_html" widget="html" nolabel="1"/>
                        <field name="other_uoms_html" widget="html" string="Units and Packaging / الوحدات والتعبئة"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>

                <footer>
                    <button string="Close / إغلاق" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action that opens the wizard (target=new) with our simple view -->
    <record id="action_open_price_checker_simple" model="ir.actions.act_window">
        <field name="name">Price Checker (New)</field>
        <field name="res_model">price.checker.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_price_checker_wizard_form_simple"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu to open the new checker under main App dashboard -->
    <menuitem id="menu_price_checker_simple_root" name="Price Checker (New)" sequence="5"
              action="action_open_price_checker_simple"/>
</odoo>
