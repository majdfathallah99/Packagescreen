<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_price_checker_wizard_form" model="ir.ui.view">
        <field name="name">price.checker.wizard.form</field>
        <field name="model">price.checker.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Checker" class="o_price_checker_form">
                <group>
                    <group>
                        <field name="pricelist_id" options="{'no_create': True}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="barcode" placeholder="Scan or type here…" required="1"/>
                        <button name="action_check" type="object" class="btn-primary" string="Check (Enter)"/>
                    </group>
                    <group>
                        <field name="image_128" widget="image" class="o_pc_img"/>
                    </group>
                </group>
                <separator string="Result"/>
                <group class="o_pc_result">
                    <group>
                        <field name="product_name" readonly="1"/>
                        <field name="uom_name" readonly="1"/>
                    </group>
                    <group>
                        <field name="list_price" readonly="1"/>
                        <field name="price" readonly="1"/>
                        <field name="currency_id" readonly="1" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_new_scan" type="object" string="New Scan" class="btn-secondary"/>
                    <button string="Close" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
