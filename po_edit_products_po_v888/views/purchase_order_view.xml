<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_edit_products" model="ir.ui.view">
        <field name="name">purchase.order.form.edit.products.popup</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_edit_order_products"
                        type="object"
                        string="تعديل الأسعار"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
