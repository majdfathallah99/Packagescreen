<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the original wizard form and insert our HTML blocks after the Result group -->
    <record id="view_price_checker_wizard_form_extend" model="ir.ui.view">
        <field name="name">price.checker.wizard.form.extend</field>
        <field name="model">price.checker.wizard</field>
        <field name="inherit_id" ref="view_price_checker_wizard_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[@string='Result']/following-sibling::group[1]" position="inside">
                <separator string="Units & Packaging / الوحدات والتعبئة"/>
                <field name="uom_html" widget="html" nolabel="1"/>
                <field name="other_uoms_html" widget="html" nolabel="1"/>
            </xpath>
        </field>
    </record>
</odoo>
