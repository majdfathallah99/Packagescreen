<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="action_ai_assistant_live" model="ir.actions.act_url">
      <field name="name">AI Assistant — Live</field>
      <field name="type">ir.actions.act_url</field>
      <field name="url">/ai_assistant/live_chat</field>
      <field name="target">self</field>
    </record>

    <!-- Top-level app tile -->
    <record id="menu_ai_assistant_live_root" model="ir.ui.menu">
