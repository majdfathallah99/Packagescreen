<?xml version="1.0" encoding="utf-8"?>
<template>
  <!-- Client action root -->
  <t t-name="CustomDashBoardFindProduct">
    <div class="oh_dashboards container" style="margin-top: 20px;">
      <div class="container-fluid o_pj_dashboard barcode_inventory" style="display:flex;">
        <t t-call="product_detail_search_template"/>
      </div>
    </div>
  </t>

  <!-- Minimal dashboard: input + 4 rows (Name, UoM, Price, Package) -->
  <t t-name="product_detail_search_template">
    <div>
      <div class="barcode_scan">
        <h2>Scan Your Barcode</h2>
        <input type="text" id="barcode" name="barcode"
               t-att-value="state.barcode"
               t-on-keypress="onProductKeypress"
               t-on-input="change_product_barcode"
               placeholder="Please scan or type the barcode"/>
      </div>

      <!-- Show result -->
      <t t-if="state.details" t-set="d" t-value="state.details"/>
      <t t-if="state.details">
        <div class="clientlist-screen screen">
          <div class="screen-content barcode_screen">
            <h1>Product Information</h1>
            <div class="container-fluid" style="display:flex; justify-content:center;">
              <table style="margin:0 auto; table-layout:fixed; width:auto; font-size:14px;">
                <tr>
                  <td class="label">Product Name:</td>
                  <td class="value"><t t-esc="d.name"/></td>
                </tr>
                <tr>
                  <td class="label">UoM:</td>
                  <td class="value"><t t-esc="d.uom"/></td>
                </tr>
                <tr>
                  <td class="label">Price:</td>
                  <td class="value">
                    <t t-esc="d.currency_symbol"/><t t-esc="d.price"/>
                  </td>
                </tr>
                <tr>
                  <td class="label">Package:</td>
                  <td class="value">
                    <t t-if="d.package_qty">
                      <t t-esc="d.package_qty"/> × <t t-esc="d.uom"/> =
                      <t t-esc="d.currency_symbol"/><t t-esc="d.package_price"/>
                    </t>
                    <t t-if="!d.package_qty">
                      No package
                    </t>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </t>

      <!-- If searched but not found -->
      <t t-if="state.details === null and state.barcode">
        <h3 style="margin-top:20px;">No Product Found</h3>
      </t>
    </div>
  </t>
</template>
