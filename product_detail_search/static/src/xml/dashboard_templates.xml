<?xml version="1.0" encoding="utf-8"?>
<templates id="pds_dashboard_templates" xml:space="preserve">

  <t t-name="CustomDashBoardFindProduct">
    <div class="pds-wrap container">
      <div class="barcode_inventory">
        <t t-call="product_detail_search_template"/>
      </div>
    </div>
  </t>

  <t t-name="product_detail_search_template">
    <div class="pds rtl">
      <div class="scan">
        <input class="scan-input"
               t-ref="scanInput"
               t-att-value="state.barcode"
               t-on-keydown="onKeyDown"
               t-on-input="onInput"
               placeholder="امسح أو اكتب الباركود / Scan or type barcode"/>
      </div>

      <t t-set="d" t-value="state.details"/>
      <t t-if="d">
        <div class="head">
          <img class="logo" src="/product_detail_search/static/description/icon.png"/>
          <div class="name"><t t-esc="d.name"/></div>
        </div>

        <div class="cards">
          <div class="tile piece">
            <div class="tile-title"><t t-esc="_t('قطعة')"/></div>
            <div class="tile-value">
              <t t-esc="((+ (d.price || d.list_price) ) || 0).toFixed(3)"/>
            </div>
            <div class="tile-sub">
              <t t-esc="(d.symbol || d.currency_symbol || '')"/> - <t t-esc="d.uom"/>
            </div>
          </div>

          <div class="tile pack">
            <div class="tile-title"><t t-esc="_t('عبوة')"/></div>
            <div class="tile-value">
              <t t-esc="((+ (d.package_price || 0) ) || 0).toFixed(3)"/>
            </div>
            <div class="tile-sub">
              <t t-esc="d.package_qty ? (d.package_qty + ' × ' + (d.uom || '')) : _t('لا توجد عبوة')"/>
            </div>
          </div>
        </div>
      </t>

      <t t-if="state.details === null &amp;&amp; state.barcode">
        <div class="not-found"><t t-esc="_t('لم يتم العثور على منتج')"/></div>
      </t>
    </div>
  </t>
</templates>
