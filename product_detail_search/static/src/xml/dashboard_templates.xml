<?xml version="1.0" encoding="utf-8"?>
<templates id="pds_dashboard_templates" xml:space="preserve">
  <!-- Client action root -->
  <t t-name="CustomDashBoardFindProduct">
    <div class="pds-wrap container">
      <div class="barcode_inventory">
        <t t-call="product_detail_search_template"/>
      </div>
    </div>
  </t>

  <!-- Minimal dashboard: input + 2 tiles -->
  <t t-name="product_detail_search_template">
    <div class="pds rtl">
      <div class="scan">
        <input class="scan-input"
               t-att-value="state.barcode"
               t-on-keypress="onProductKeypress"
               t-on-input="change_product_barcode"
               placeholder="امسح أو اكتب الباركود / Scan or type barcode"/>
      </div>

      <t t-if="state.details" t-set="d" t-value="state.details"/>
      <t t-if="state.details">
        <div class="head">
          <img class="logo" src="/product_detail_search/static/description/icon.png"/>
          <div class="name" t-esc="d.name"/>
        </div>

        <div class="tiles">
          <div class="tile">
            <div class="tile-header tile-orange"><t t-esc="_t('عبوة')"/></div>
            <div class="tile-value"><t t-esc="(d.package_price || 0).toFixed(3)"/></div>
            <div class="tile-sub" t-if="d.package_qty">
              <t t-esc="d.currency_symbol"/> • <t t-esc="d.package_qty"/> × <t t-esc="d.uom"/>
            </div>
            <div class="tile-sub" t-if="!d.package_qty"><t t-esc="_t('لا توجد عبوة')"/></div>
          </div>

          <div class="tile">
            <div class="tile-header tile-blue"><t t-esc="_t('قطعة')"/></div>
            <div class="tile-value"><t t-esc="(d.price || 0).toFixed(3)"/></div>
            <div class="tile-sub"><t t-esc="d.currency_symbol"/> • <t t-esc="d.uom"/></div>
          </div>
        </div>
      </t>

      <t t-if="state.details === null && state.barcode">
        <div class="not-found"><t t-esc="_t('لم يتم العثور على منتج')"/></div>
      </t>
    </div>
  </t>
</templates>
