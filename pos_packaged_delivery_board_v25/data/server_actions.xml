<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action in the Action menu: Refresh Board Now (no popup) -->
    <record id="ir_actions_server_refresh_board" model="ir.actions.server">
        <field name="name">Refresh Board Now</field>
        <field name="model_id" ref="model_pos_packaged_card"/>
        <field name="binding_model_id" ref="model_pos_packaged_card"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = env['pos.packaged.card'].action_refresh_board()</field>
    </record>

    <!-- Optional: Cron to auto-sync every 5 minutes -->
    <record id="ir_cron_ppdb_auto_sync" model="ir.cron">
        <field name="name">POS Packaged: Auto Sync</field>
        <field name="model_id" ref="model_pos_packaged_card"/>
        <field name="state">code</field>
        <field name="code">model.cron_auto_sync()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
