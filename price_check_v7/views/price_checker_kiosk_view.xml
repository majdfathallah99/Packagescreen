<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_price_checker_kiosk_form" model="ir.ui.view">
    <field name="name">price.checker.kiosk.form</field>
    <field name="model">price.checker.wizard</field>
    <field name="arch" type="xml">
      <form string="Start Scanner" create="0" edit="0" delete="0">
        <group><field name="barcode" placeholder="Scan or type..." force_save="1"/></group>
        <separator/><field name="kiosk_html" widget="html" nolabel="1"/>
        <footer><button string="Close" class="btn-secondary" special="cancel"/></footer>
      </form>
    </field>
  </record>

  <record id="action_price_checker_fullpage" model="ir.actions.act_url">
    <field name="name">Start Scanner</field>
    <field name="type">ir.actions.act_url</field>
    <field name="url">/price_check/kiosk</field>
    <field name="target">self</field>
  </record>

  <menuitem id="menu_price_checker_app" name="Price Checker" sequence="10"
            web_icon="price_check,static/description/icon.png"/>
  <menuitem id="menu_price_checker_fullpage" name="Start Scanner" parent="menu_price_checker_app"
            action="action_price_checker_fullpage" sequence="1"/>
</odoo>
