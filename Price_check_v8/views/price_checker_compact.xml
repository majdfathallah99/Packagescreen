<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="price_checker_wizard_form_compact" model="ir.ui.view">
      <field name="name">price.checker.wizard.form.compact</field>
      <field name="model">price.checker.wizard</field>
      <field name="inherit_id" ref="v16.view_price_checker_wizard_form"/>
      <field name="priority" eval="50"/>
      <field name="arch" type="xml">
        <!-- Remove Pricelist & Customer fields -->
        <xpath expr="//field[@name='pricelist_id']" position="replace"/>
        <xpath expr="//field[@name='partner_id']" position="replace"/>
        <!-- Remove any explicit pricelist price rows/labels -->
        <xpath expr="//field[@name='pricelist_price']" position="replace"/>
        <xpath expr="//label[@for='pricelist_price']" position="replace"/>
        <xpath expr="//field[@name='price_pricelist']" position="replace"/>
        <xpath expr="//label[@for='price_pricelist']" position="replace"/>
        <!-- Also hide helper controls referencing customer/pricelist if present -->
        <xpath expr="//span[@t-field='o.pricelist_id']" position="replace"/>
        <xpath expr="//span[@t-field='o.partner_id']" position="replace"/>
      </field>
    </record>
  </data>
</odoo>
