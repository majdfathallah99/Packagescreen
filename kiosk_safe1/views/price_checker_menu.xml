<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action opens the wizard in a modal -->
    <record id="action_price_checker_wizard" model="ir.actions.act_window">
        <field name="name">Price Checker</field>
        <field name="res_model">price.checker.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Top-level app with icon -->
    <menuitem id="menu_price_checker_app"
              name="Price Checker"
              sequence="20"
              web_icon="price_checker_kiosk,static/description/icon.png"/>

    <!-- Click-through menu to open the wizard -->
    <menuitem id="menu_price_checker_open"
              name="Start Scanner"
              parent="menu_price_checker_app"
              action="action_price_checker_wizard"
              sequence="1"/>
</odoo>
