<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_price_checker_wizard_form" model="ir.ui.view">
        <field name="name">price.checker.wizard.form</field>
        <field name="model">price.checker.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Checker / فاحص الأسعار">
                <group>
                    <group>
                        <field name="barcode" placeholder="Scan / امسح الباركود" required="1"/>
                    </group>
                </group>

                <separator string="Result / النتيجة"/>

                <group>
                    <group>
                        <label string="Product / المنتج"/>
                        <div>
                            <h1 t-esc="o.product_name or ''"/>
                        </div>
                        <label string="Barcode / الباركود"/>
                        <div>
                            <h2 t-esc="o.barcode or ''"/>
                        </div>
                        <label string="Price / السعر"/>
                        <div>
                            <h1>
                                <t t-esc="o.price or 0.0"/> <t t-esc="o.currency_id.symbol or ''"/>
                            </h1>
                        </div>
                        <label string="UoM / وحدة القياس"/>
                        <div>
                            <h3 t-esc="o.uom_name or ''"/>
                        </div>
                        <label string="Other UoMs / وحدات أخرى"/>
                        <field name="other_uoms_html" widget="html"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>

                <footer>
                    <button string="Close / إغلاق" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
