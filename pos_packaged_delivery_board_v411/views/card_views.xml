<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_pos_packaged_card_kanban" model="ir.ui.view">
    <field name="name">pos.packaged.card.kanban</field>
    <field name="model">pos.packaged.card</field>
    <field name="arch" type="xml">
      <kanban create="false" default_group_by="state" class="o_kanban_small_column">
        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record oe_kanban_global_click">
              <!-- Make sure the fields are loaded in the payload -->
              <field name="state" invisible="1"/>
              <field name="product_id" invisible="1"/>
              <field name="image_data_uri" invisible="1"/>

              <div class="d-flex align-items-start gap-2">
                <!-- ✅ Show the precomputed data URI directly -->
                <div class="o_kanban_image d-flex align-items-center justify-content-center"
                     style="width:56px;height:56px;border-radius:8px;overflow:hidden;background:#f8f9fa;">
                  <img class="o_avatar o_avatar_64"
                       t-att-src="(record.image_data_uri and record.image_data_uri.value) or '/web/static/img/placeholder.png'"
                       t-att-alt="record.product_id and record.product_id.value or ''"
                       style="width:56px;height:56px;object-fit:cover;"/>
                </div>

                <div class="o_kanban_details">
                  <strong><field name="product_id"/></strong>
                  <div class="text-muted"><span>Order: </span><field name="order_id"/></div>
                  <div class="text-muted"><span>UoM: </span><field name="used_uom_id"/> · <span>Qty: </span><field name="qty"/></div>
                  <div class="text-muted"><span>Date: </span><field name="date_order"/></div>
                </div>
              </div>

              <div class="o_kanban_footer mt-2">
                <t t-if="record.state and record.state.raw_value == 'new'">
                  <button type="object" name="action_confirm" class="oe_kanban_action oe_kanban_button btn-primary">Confirm</button>
                </t>
                <t t-if="record.state and record.state.raw_value == 'confirmed'">
                  <span class="badge badge-success">Confirmed</span>
                  <button type="object" name="action_reset" class="oe_kanban_action oe_kanban_button ms-2">Reset</button>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
</odoo>
