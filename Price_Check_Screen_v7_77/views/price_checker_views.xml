<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_price_checker_wizard_form" model="ir.ui.view">
        <field name="name">price.checker.wizard.form</field>
        <field name="model">price.checker.wizard</field>
        <field name="arch" type="xml">
            
<form string="Price Checker">
                <group>
                    <group>
                        <field name="barcode" placeholder="Scan here…" required="1"/>
                    </group>
                </group>
                <separator string="Result"/>
                <group>
                    <group>
                        <label string="Product"/>
                        <h1>
                            <field name="product_name" readonly="1" nolabel="1"/>
                        </h1>
                        <field name="uom_name" readonly="1" attrs="{'invisible': [('uom_name','=',False)]}"/>
                        <label string="Price"/>
                        <field name="price" readonly="1"/>
                        <field name="currency_id" readonly="1" invisible="1"/>
                    </group>
                </group>
            </form>

        </field>
    </record>
</odoo>
