<odoo>
    <record id="action_ai_assistant" model="ir.actions.act_url">
        <field name="name">GPT-5 Assistant</field>
        <field name="url">/ai_assistant</field>
        <field name="target">self</field>
    </record>

    <record id="action_ai_assistant_settings" model="ir.actions.act_url">
        <field name="name">GPT-5 Assistant Settings</field>
        <field name="url">/ai_assistant/settings</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_ai_assistant_root" name="GPT-5 Assistant" sequence="10" action="action_ai_assistant"/>
    <menuitem id="menu_ai_assistant_settings" name="Settings" parent="menu_ai_assistant_root" sequence="20" action="action_ai_assistant_settings"/>
</odoo>
