<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_price_checker_wizard_form_override" model="ir.ui.view">
      <field name="name">price.checker.wizard.form.override</field>
      <field name="model">price.checker.wizard</field>
      <field name="inherit_id" ref="view_price_checker_wizard_form"/>
      <field name="priority" eval="200"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="replace">
          <form string="Price Checker">
            <group>
              <group>
                <field name="barcode" placeholder="Scan here…" required="1"/>
              </group>
              <group>
                <field name="image_128" widget="image" readonly="1"/>
              </group>
            </group>
            <separator string="Result"/>
            <group>
              <group>
                <field name="product_name" readonly="1"/>
                <field name="uom_name" readonly="1"/>
              </group>
              <group>
                <field name="list_price" readonly="1"/>
                <field name="price" readonly="1"/>
                <field name="currency_id" readonly="1" invisible="1"/>
              </group>
            </group>
            <footer>
              <button name="action_new_scan" type="object" string="New Scan" class="btn-secondary"/>
              <button special="cancel" string="Close" class="btn-primary"/>
            </footer>
          </form>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
