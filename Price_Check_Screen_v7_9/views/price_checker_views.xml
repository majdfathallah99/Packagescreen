<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_price_checker_wizard_form" model="ir.ui.view">
        <field name="name">price.checker.wizard.form</field>
        <field name="model">price.checker.wizard</field>
        <field name="arch" type="xml">
            <form string="Price Checker">
    <div class="pc-hidden-input">
        <field name="barcode" placeholder="Scan here…" required="1" nolabel="1"/>
    </div>
    <group>
        <field name="product_name" nolabel="1" readonly="1" class="pc-product-name"/>
        <field name="uom_name" nolabel="1" readonly="1" class="pc-uom" invisible="not uom_name" />
        <field name="price" nolabel="1" readonly="1" class="pc-price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
        <field name="currency_id" readonly="1" invisible="1"/>
    </group>
    <footer>
        <button string="Close" class="btn-primary" special="cancel"/>
    </footer>
</form>
        </field>
    </record>
</odoo>
